<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cinema.styles.css" asp-append-version="true" />
    <link href="~/css/admin/dashboard.css" rel="stylesheet" />
    <link href="~/css/customer/customer.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">

</head>
<body>
    <header>
        <!-- Sidebar -->
        <aside class="sidebar">
            <a class="brand" href="/">
                <span class="brand-name">CINIMA</span>
                <span class="brand-sub">Admin Dashboard</span>
            </a>

            <nav class="nav">
                <a href="/Customer/Home/Index" class="active" aria-current="page">Home</a>
                <a href="/Customer/Movie/Index">Movies</a>
                <a href="/Customer/Category/Index">Categories</a>
                <a href="/Customer/Cinema/Index">Cinemas</a>
                <a href="/Customer/Actor/Index">Actors</a>
            </nav>
        </aside>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <footer class="footer">
            <span class="bebas">CINIMA</span>
            <span>&copy; 2026 Cinima Admin Dashboard</span>
            <span>Movies &middot; Cinemas &middot; Actors</span>
        </footer>
    </div>

    

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin/dashboard.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
