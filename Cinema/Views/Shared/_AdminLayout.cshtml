<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema</title>

    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/category.css" asp-append-version="true" />
    <link href="~/css/admin/newdashboard.css" rel="stylesheet" />
    <link href="~/css/identity/authlayout.css" rel="stylesheet" />
    <link href="~/css/identity/register.css" rel="stylesheet" />
    <link href="~/css/identity/profile.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <aside class="sidebar">
        <a class="brand" href="/Admin/Home/Index">
            <span class="brand-name">CINEMA</span>
            <span class="brand-sub">Admin Dashboard</span>
        </a>

        <nav class="nav">
            <a href="/Admin/Home/Index">Dashboard</a>
            <a href="/Admin/Movie/Index">Movies</a>
            <a href="/Admin/Category/Index">Categories</a>
            <a href="/Admin/Cinema/Index">Cinemas</a>
            <a href="/Admin/Actor/Index">Actors</a>
            <a href="/Customer/Cart/Index">Cart</a>
        </nav>

        <div class="sidebar-auth">
            @if (!User.Identity.IsAuthenticated)
            {
                <div class="linkrow">
                    <a class="lr-login" href="/Identity/Account/Login">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" />
                        </svg>
                        Log in
                    </a>
                    <span class="lr-or">or</span>
                    <a class="lr-signup" href="/Identity/Account/Register">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="8" r="4" />
                            <path d="M2 21c0-4 3-6 7-6s7 2 7 6M19 8v6M16 11h6" />
                        </svg>
                        Sign up
                    </a>
                </div>
            }
            else
            {
                <div class="userbar">
                    <a class="userbar-profile" href="/Identity/Profile/Index">
                        <span class="userbar-avatar">@User.Identity.Name[0]</span>
                        <span class="userbar-info">
                            <span class="userbar-name">@User.Identity.Name</span>
                            <span class="userbar-sub">View profile</span>
                        </span>
                    </a>
                    <a class="userbar-logout" href="/Identity/Account/Logout" title="Log out" aria-label="Log out">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
                        </svg>
                    </a>
                </div>
            }
        </div>
    </aside>

    <div class="main">
        <main class="content" role="main">
            @RenderBody()
        </main>

        <footer class="footer">
            <span>&copy; @DateTime.Now.Year Cinema Admin</span>
            <span>Movies &middot; Cinemas &middot; Actors</span>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Admin/dashboard.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>