@model List<Cinema>
<header class="page-head">
    <div>
        <h1>Cinemas</h1>
        <p class="subtitle">Group movies by genre</p>
    </div>
    <a class="btn" href="/Admin/Cinema/Create">Add cinema</a>
</header>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Cinema Name</th>
                <th>Description</th>
                <th class="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td class="actions">
                        <div class="actions-group">
                            <a class="row-btn update" href="/Admin/Cinema/Update/@item.Id">Update</a>
                            <a class="row-btn delete delete-confirm" href="/Admin/Cinema/Delete/@item.Id">Delete</a>                        
                        </div>
                    </td>
                </tr>
            }
            
        </tbody>
    </table>
</div>

<script>
    document.querySelectorAll('.delete-confirm').forEach(button => {
        button.addEventListener('click', function (e) {
            e.preventDefault();

            const url = this.href;

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        });
    });
</script>