@model List<ApplicationUser>
<header class="page-head">
    <div>
        <h1>Categories</h1>
        <p class="subtitle">Group movies by genre</p>
    </div>
    <a class="btn" href="/Admin/Category/Create">Add category</a>
</header>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>UserName</th>
                <th>Email</th>
                <th>Confirmed Email</th>
                <th class="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.UserName</td>
                    <td>@item.Email</td>
                    <td>
                        @if (item.EmailConfirmed)
                        {
                            <span class="badge text-bg-success">
                                Confirm
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">
                                Not Confirm
                            </span>
                        }
                    </td>
                    <td class="actions">
                        <div class="actions-group">
                            @if (item.LockoutEnd == null || DateTime.UtcNow > item.LockoutEnd)
                            {
                                <a class="row-btn update" href="/Admin/User/LockUnLock/@item.Id">Lock</a>
                            }
                            else
                            {
                                <a class="row-btn update" href="/Admin/User/LockUnLock/@item.Id">UnLock</a>
                            }

                        </div>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
@section Scripts {
    <partial name="_NotificationPartial" />
    <partial name="_ValidationScriptsPartial" />
}
<script>
    document.querySelectorAll('.delete-confirm').forEach(button => {
        button.addEventListener('click', function (e) {
            e.preventDefault();

            const url = this.href;

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        });
    });
</script>
