<div class="container">

    <header class="page-head">
        <div>
            <h1>New category</h1>
            <p class="subtitle">Group movies by genre</p>
        </div>
    </header>

    <form method="post" class="form-panel">

        <div class="form-group">
            <label for="Name">Name</label>
            <input class="form-control" id="Name" name="Name" placeholder="e.g. Action" autofocus />
            <span class="field-error"></span>
        </div>

        <div class="form-group">
            <label for="Description">Description</label>
            <textarea class="form-control" id="Description" name="Description" placeholder="Optional"></textarea>
            <span class="field-error"></span>
        </div>

        <div class="form-bar">
            <button type="submit" class="btn">Save category</button>
            <a class="btn-cancel" href="/Admin/Category/Index">Cancel</a>
        </div>

    </form>

</div>