@model Category
<div class="container">

    <header class="page-head">
        <div>
            <h1>Update category</h1>
            <p class="subtitle">Group movies by genre</p>
        </div>
    </header>

    <form method="post" class="form-panel">
        <input name="Id" value="@Model.Id" hidden/>

        <div class="form-group">
            <label for="Name">Name</label>
            <input class="form-control" id="Name" name="Name" value="@Model.Name" autofocus />
            <span class="field-error"></span>
        </div>

        <div class="form-group">
            <label for="Description">Description</label>
            <textarea class="form-control" id="Description" name="Description" >@Model.Description</textarea>
            <span class="field-error"></span>
        </div>

        <div class="form-bar">
            <button type="submit" class="btn">Update category</button>
            <a class="btn-cancel" href="/Admin/Category/Index">Cancel</a>
        </div>

    </form>

</div>