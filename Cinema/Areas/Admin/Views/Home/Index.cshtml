@{
    ViewData["Title"] = "Home Page";
}

<div class="container">

    <header class="page-head">
        <div>
            <h1>Now Showing</h1>
            <p class="subtitle">Pick a movie and book your seat</p>
        </div>
    </header>

    <div class="movie-grid">

        <article class="movie-card">
            <a href="#" class="movie-poster">
                <img src="/images/movies/inception.jpg" alt="Inception" />
                <span class="movie-overlay">View details</span>
            </a>
            <div class="movie-info">
                <h3 class="movie-title">Inception</h3>
                <p class="movie-meta">Sci-Fi</p>
                <p class="movie-price">120 EGP</p>
            </div>
        </article>

        <article class="movie-card">
            <a href="#" class="movie-poster">
                <img src="/images/movies/dark-knight.jpg" alt="The Dark Knight" />
                <span class="movie-overlay">View details</span>
            </a>
            <div class="movie-info">
                <h3 class="movie-title">The Dark Knight</h3>
                <p class="movie-meta">Action</p>
                <p class="movie-price">130 EGP</p>
            </div>
        </article>

        <article class="movie-card">
            <a href="#" class="movie-poster">
                <img src="/images/movies/interstellar.jpg" alt="Interstellar" />
                <span class="movie-overlay">View details</span>
            </a>
            <div class="movie-info">
                <h3 class="movie-title">Interstellar</h3>
                <p class="movie-meta">Sci-Fi</p>
                <p class="movie-price">140 EGP</p>
            </div>
        </article>

        <article class="movie-card">
            <a href="#" class="movie-poster">
                <img src="/images/movies/joker.jpg" alt="Joker" />
                <span class="movie-overlay">View details</span>
            </a>
            <div class="movie-info">
                <h3 class="movie-title">Joker</h3>
                <p class="movie-meta">Drama</p>
                <p class="movie-price">110 EGP</p>
            </div>
        </article>

        <article class="movie-card">
            <a href="#" class="movie-poster">
                <span class="poster-placeholder">Coco</span>
                <span class="movie-overlay">View details</span>
            </a>
            <div class="movie-info">
                <h3 class="movie-title">Coco</h3>
                <p class="movie-meta">Family</p>
                <p class="movie-price">90 EGP</p>
            </div>
        </article>

        <article class="movie-card">
            <a href="#" class="movie-poster">
                <span class="poster-placeholder">The Conjuring</span>
                <span class="movie-overlay">View details</span>
            </a>
            <div class="movie-info">
                <h3 class="movie-title">The Conjuring</h3>
                <p class="movie-meta">Horror</p>
                <p class="movie-price">100 EGP</p>
            </div>
        </article>

    </div>

</div>
