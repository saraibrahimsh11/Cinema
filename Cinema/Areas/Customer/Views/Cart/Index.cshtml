@using System.Globalization
@model List<Cart>
@{
    ViewData["Title"] = "My Cart";

    var inv = CultureInfo.InvariantCulture;
    var totalTickets = Model.Sum(i => i.Count);
    var totalPrice = Model.Sum(i => i.Movie.Price * i.Count);
}

<link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />

<div class="cart">

    <header class="page-hero">
        <div>
            <span class="hero-tag">Cart</span>
            <h1>My Cart</h1>
            <p class="rail-sub">Review your tickets before checkout</p>
        </div>
        <div class="hero-count">
            <strong>@totalTickets</strong>
            <span>Tickets</span>
        </div>
    </header>

    @if (TempData["Error"] is string err)
    {
        <div class="cart-alert">@err</div>
    }

    @if (Model.Count == 0)
    {
        <div class="cart-empty">
            <p>Your cart is empty.</p>
            <a class="cart-btn" asp-controller="Home" asp-action="Index">Browse movies</a>
        </div>
    }
    else
    {
        <div class="cart-grid">

            <section class="cart-items">
                @foreach (var item in Model)
                {
                    var m = item.Movie;
                    <article class="cart-item">
                        <img class="cart-poster" src="/images/Movie/@m.MainImg" alt="@m.Name" />

                        <div class="cart-info">
                            <h3>
                                <a asp-controller="Home" asp-action="MovieDetails" asp-route-id="@m.Id">@m.Name</a>
                            </h3>
                            <p class="cart-date">@m.DateTime.ToString("ddd, dd MMM yyyy · hh:mm tt", inv)</p>
                            <p class="cart-unit">@m.Price.ToString("0.##", inv) EGP per ticket</p>
                        </div>

                        <form method="post" class="cart-stepper">
                            <input type="hidden" name="movieId" value="@item.MovieId" />
                            <button type="submit" asp-action="DecrementMovie"
                                    aria-label="Decrease tickets" disabled="@(item.Count <= 1)">
                                &minus;
                            </button>
                            <span>@item.Count</span>
                            <button type="submit" asp-action="IncrementMovie"
                                    aria-label="Increase tickets" disabled="@(item.Count >= m.Quantity)">
                                +
                            </button>
                        </form>

                        <div class="cart-line">@((m.Price * item.Count).ToString("0.##", inv)) <small>EGP</small></div>

                        <form asp-action="DeleteMovie" method="post">
                            <input type="hidden" name="movieId" value="@item.MovieId" />
                            <button type="submit" class="cart-remove" aria-label="Remove @m.Name"
                                    onclick="return confirm('Remove this movie from your cart?');">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6" />
                                </svg>
                            </button>
                        </form>
                    </article>
                }
            </section>

            <aside class="cart-summary">
                <h2>Order summary</h2>

                <div class="cart-row"><span>Movies</span><b>@Model.Count</b></div>
                <div class="cart-row"><span>Tickets</span><b>@totalTickets</b></div>
                <div class="cart-row cart-total">
                    <span>Total</span>
                    <strong>@totalPrice.ToString("0.##", inv) <small>EGP</small></strong>
                </div>

                @* TODO: وجّه لصفحة الدفع لما تعملها *@
                <a href="/Customer/Cart/Pay" class="cart-btn">Proceed to checkout</a>
                <a class="cart-continue" asp-controller="Home" asp-action="Index">Continue browsing</a>
            </aside>

        </div>
    }
</div>
