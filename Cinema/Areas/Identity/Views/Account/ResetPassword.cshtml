@model ResetPasswordVM
<div class="container">
    <div class="auth-wrap">

        <form method="post" asp-action="ResendEmailConfirmation" class="form-panel auth-card">

            <div class="auth-head">
                <div class="auth-brand">CINEMA</div>
                <h1 class="auth-title">Create New Password</h1>
                <p class="auth-sub">Choose a strong password to secure your account</p>
            </div>

            <input asp-for="UserId" hidden />
            <input asp-for="Token" hidden />
            <div asp-validation-summary="ModelOnly" class="field-error auth-summary"></div>

            <div class="form-group">
                <label asp-for="NewPassword">New Password</label>
                <input asp-for="NewPassword" class="form-control" placeholder="Your password" autocomplete="current-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm New Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="confirm password" autocomplete="current-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-block">Reset Password</button>

            
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
