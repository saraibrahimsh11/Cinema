@model ForgetPasswordVM
<div class="container">
    <div class="auth-wrap">

        <form method="post" asp-action="ForgetPassword" class="form-panel auth-card">

            <div class="auth-head">
                <div class="auth-brand">CINEMA</div>
                <h1 class="auth-title">Reset your password</h1>
                <p class="auth-sub">Enter your username or email and we'll send you a verification code</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="field-error auth-summary"></div>

            <div class="form-group">
                <label asp-for="UserNameOrEmail">Username or email</label>
                <input asp-for="UserNameOrEmail" class="form-control" placeholder="name@example.com" autocomplete="username" autofocus />
                <span asp-validation-for="UserNameOrEmail" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-block">Send Verification Code</button>

            <p class="auth-switch">
                <a asp-action="Login">Back to login</a>
            </p>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}