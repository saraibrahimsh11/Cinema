@model VerifyOtpVM
@{
    ViewData["Title"] = "Verify code";
}

<div class="container">
    <div class="auth-wrap">

        <form method="post" asp-action="VerifyOtp" class="form-panel auth-card otp-card">

            <input asp-for="UserId" hidden />

            <div class="auth-head">
                <div class="otp-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z" />
                        <path d="M9 12l2 2 4-4" />
                    </svg>
                </div>
                <h1 class="auth-title">Verify your code</h1>
                <p class="auth-sub">We sent a 4-digit code to your email</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="field-error auth-summary"></div>

            @* <div class="otp-boxes">
                <input class="otp-box" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" aria-label="Digit 1" autofocus />
                <input class="otp-box" type="text" inputmode="numeric" pattern="[0-9]*" aria-label="Digit 2" />
                <input class="otp-box" type="text" inputmode="numeric" pattern="[0-9]*" aria-label="Digit 3" />
                <input class="otp-box" type="text" inputmode="numeric" pattern="[0-9]*" aria-label="Digit 4" />
            </div> *@

            <div class="form-group">
                <input asp-for="OTP" class="form-control" placeholder="Your password" autocomplete="current-password" />
                <span asp-validation-for="OTP" class="field-error"></span>
            </div>
            <span asp-validation-for="OTP" class="field-error otp-error"></span>

            <button type="submit" class="btn btn-block">Verify</button>

            <p class="auth-switch">
                Didn't get the code?
                <a asp-action="ResendOtp">Resend</a>
            </p>

        </form>

    </div>
</div>

