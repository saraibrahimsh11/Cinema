@using System.Globalization
@using Cinema.ViewModel
@{
    ViewData["Title"] = "Home Page";
}

@{
    ViewData["Title"] = "Home Page";

    string F(double d) => d.ToString("0.##", CultureInfo.InvariantCulture);
}
@model DashboardVM
<div class="dash">

    <header class="page-head">
        <div>
            <h1>Dashboard</h1>
            <p class="subtitle">Overview of your cinema at a glance</p>
        </div>
        <a class="btn" href="/Admin/Movie/Create">Add movie</a>
    </header>

    <!-- Stat cards -->
    <section class="dash-stats">
        <a class="dash-stat" href="/Admin/Movie/Index">
            <span class="dash-stat-label">Movies</span>
            <span class="dash-stat-value">@Model.MoviesCount</span>
            <span class="dash-stat-note">@Model.NowShowing now showing</span>
        </a>
        <a class="dash-stat" href="/Admin/Category/Index">
            <span class="dash-stat-label">Categories</span>
            <span class="dash-stat-value">@Model.CategoriesCount</span>
            <span class="dash-stat-note">Genres in the system</span>
        </a>
        <a class="dash-stat" href="/Admin/Cinema/Index">
            <span class="dash-stat-label">Cinemas</span>
            <span class="dash-stat-value">@Model.CinemasCount</span>
            <span class="dash-stat-note">Branches / halls</span>
        </a>
        <a class="dash-stat" href="/Admin/Actor/Index">
            <span class="dash-stat-label">Actors</span>
            <span class="dash-stat-value">@Model.ActorsCount</span>
            <span class="dash-stat-note">Cast members</span>
        </a>
    </section>

    <!-- Secondary numbers -->
    <section class="dash-mini">
        <div class="dash-mini-item">
            <span class="dash-mini-value">@Model.AveragePrice.ToString("0.##", CultureInfo.InvariantCulture) <small>EGP</small></span>
            <span class="dash-mini-label">Average ticket price</span>
        </div>
        <div class="dash-mini-item">
            <span class="dash-mini-value">@F(Model.AverageRate)</span>
            <span class="dash-mini-label">Average rating</span>
        </div>
        <div class="dash-mini-item">
            <span class="dash-mini-value">@Model.TotalQuantity</span>
            <span class="dash-mini-label">Total quantity</span>
        </div>
    </section>

    <!-- Lists -->
    <section class="dash-grid dash-grid-2">

        <div class="dash-card">
            <div class="dash-card-head">
                <h2>Latest movies</h2>
                <a href="/Admin/Movie/Index">View all</a>
            </div>
            @if (!Model.Latest.Any())
            {
                <p class="dash-empty">No movies yet.</p>
            }
            else
            {
                <ul class="dash-list">
                    @foreach (var m in Model.Latest)
                    {
                        <li>
                            <img src="/images/Movie/@m.MainImg" alt="@m.Name" onerror="this.style.visibility='hidden'" />
                            <div class="dash-list-info">
                                <strong>@m.Name</strong>
                                <span>@m.Category?.Name &middot; @m.Cinema?.Name</span>
                            </div>
                            <span class="dash-badge @(m.Status == 1 ? "gold" : m.Status == 2 ? "red" : "grey")">
                                @(m.Status == 1 ? "Now Showing" : m.Status == 2 ? "Coming Soon" : "Ended")
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="dash-card">
            <div class="dash-card-head">
                <h2>Top rated</h2>
                <a href="/Admin/Movie/Index">View all</a>
            </div>
            @if (!Model.TopRated.Any())
            {
                <p class="dash-empty">No movies yet.</p>
            }
            else
            {
                <ul class="dash-list">
                    @foreach (var m in Model.TopRated)
                    {
                        <li>
                            <img src="/images/Movie/@m.MainImg" alt="@m.Name" onerror="this.style.visibility='hidden'" />
                            <div class="dash-list-info">
                                <strong>@m.Name</strong>
                                <span>@m.Category?.Name &middot; @m.Price.ToString("0.##", CultureInfo.InvariantCulture) EGP</span>
                            </div>
                            <span class="dash-rate">&#9733; @m.Rate</span>
                        </li>
                    }
                </ul>
            }
        </div>

    </section>

</div>
