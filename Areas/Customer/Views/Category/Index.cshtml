@model List<Category>
<header class="page-hero">
    <div>
        <span class="hero-tag">Categories</span>
        <h1>Our Categories</h1>
        <p class="subtitle">Meet the stars of our movies</p>
    </div>
    <div class="hero-count">
        <strong>@Model.Count()</strong>
        <span>categories</span>
    </div>
</header>

<form method="get" class="filter-bar">

    <div class="filter-field filter-search">
        <label for="search">Search</label>
        <input type="text" id="search" name="Name" placeholder="e.g. Action" />
    </div>

    <button type="submit" class="btn">Filter</button>
</form>

<div class="category-grid">
    @foreach(var item in Model)
    {
        <article class="actor-card">
            <a href="#" class="actor-photo">
            </a>
            <div class="actor-body">
                <h3 class="actor-name">@item.Name</h3>
                <p class="actor-desc">@item.Description</p>
            </div>
        </article>
    }

</div>

<nav aria-label="Page navigation" class="pager">
    <ul class="pagination">
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" href="/Customer/Category/Index?page=@(ViewBag.CurrentPage - 1)&Name=@Context.Request.Query["Name"]" aria-label="Previous">
                <span aria-hidden="true">&larr;</span> Prev
            </a>
        </li>
        @for (var i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                <a class="page-link" href="/Customer/Category/Index?page=@i&Name=@Context.Request.Query["Name"]">@i</a>
            </li>
        }
        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link" href="/Customer/Category/Index?page=@(ViewBag.CurrentPage + 1)&Name=@Context.Request.Query["Name"]" aria-label="Next">
                Next <span aria-hidden="true">&rarr;</span>
            </a>
        </li>
    </ul>
    <p class="pager-info">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</p>
</nav>